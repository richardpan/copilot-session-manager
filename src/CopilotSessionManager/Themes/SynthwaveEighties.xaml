<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <!--
        80s Synthwave palette — deep midnight-purple backgrounds with neon hot-pink,
        electric magenta, and cyan accents inspired by retrowave / outrun aesthetics
        (Robert Beatty, Kavinsky, Miami Vice). Component bytes are used instead of hex
        literals so every colour token lives behind a named resource, matching the
        convention used by the other theme dictionaries.
    -->
    <SolidColorBrush x:Key="BackgroundBrush"><SolidColorBrush.Color><Color A="255" R="20" G="13" B="46" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush"><SolidColorBrush.Color><Color A="255" R="29" G="18" B="61" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush"><SolidColorBrush.Color><Color A="255" R="14" G="9" B="36" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceHoverBrush"><SolidColorBrush.Color><Color A="255" R="46" G="27" B="92" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="OverlayBrush"><SolidColorBrush.Color><Color A="255" R="61" G="37" B="112" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush"><SolidColorBrush.Color><Color A="255" R="123" G="76" B="186" /></SolidColorBrush.Color></SolidColorBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush"><SolidColorBrush.Color><Color A="255" R="241" G="232" B="255" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush"><SolidColorBrush.Color><Color A="255" R="207" G="195" B="240" /></SolidColorBrush.Color></SolidColorBrush>
    <!-- Muted text targets WCAG 2.1 AA 4.5:1 against the deep-purple surfaces. -->
    <SolidColorBrush x:Key="TextMutedBrush"><SolidColorBrush.Color><Color A="255" R="184" G="170" B="222" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="TextPlaceholderBrush"><SolidColorBrush.Color><Color A="255" R="156" G="142" B="195" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="TextOnAccentBrush"><SolidColorBrush.Color><Color A="255" R="14" G="9" B="36" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BadgeTextBrush"><SolidColorBrush.Color><Color A="255" R="14" G="9" B="36" /></SolidColorBrush.Color></SolidColorBrush>

    <SolidColorBrush x:Key="AccentBrush"><SolidColorBrush.Color><Color A="255" R="255" G="113" B="206" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="FocusOutlineBrush"><SolidColorBrush.Color><Color A="255" R="1" G="205" B="254" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActionBrush"><SolidColorBrush.Color><Color A="255" R="255" G="113" B="206" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActionBorderBrush"><SolidColorBrush.Color><Color A="255" R="225" G="86" B="178" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryActionAltBorderBrush"><SolidColorBrush.Color><Color A="255" R="1" G="205" B="254" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="LinkBrush"><SolidColorBrush.Color><Color A="255" R="1" G="205" B="254" /></SolidColorBrush.Color></SolidColorBrush>

    <SolidColorBrush x:Key="SuccessBrush"><SolidColorBrush.Color><Color A="255" R="114" G="247" B="174" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="LifecycleActiveBrush"><SolidColorBrush.Color><Color A="255" R="31" G="181" B="112" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBorderBrush"><SolidColorBrush.Color><Color A="255" R="92" G="219" B="151" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="DangerBrush"><SolidColorBrush.Color><Color A="255" R="255" G="80" B="120" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush"><SolidColorBrush.Color><Color A="255" R="255" G="80" B="120" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="WarningSurfaceBrush"><SolidColorBrush.Color><Color A="255" R="71" G="40" B="20" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="DangerSurfaceBrush"><SolidColorBrush.Color><Color A="255" R="71" G="20" B="40" /></SolidColorBrush.Color></SolidColorBrush>

    <SolidColorBrush x:Key="StatusWorkingBrush"><SolidColorBrush.Color><Color A="255" R="114" G="247" B="174" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="StatusAwaitingBrush"><SolidColorBrush.Color><Color A="255" R="255" G="204" B="102" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="StatusInputBrush"><SolidColorBrush.Color><Color A="255" R="1" G="205" B="254" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="StatusIdleBrush"><SolidColorBrush.Color><Color A="255" R="156" G="142" B="195" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="StatusInactiveBrush"><SolidColorBrush.Color><Color A="255" R="156" G="142" B="195" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="StatusCrashedBrush"><SolidColorBrush.Color><Color A="255" R="255" G="80" B="120" /></SolidColorBrush.Color></SolidColorBrush>

    <SolidColorBrush x:Key="BadgeOpenBrush"><SolidColorBrush.Color><Color A="255" R="114" G="247" B="174" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BadgeClosedBrush"><SolidColorBrush.Color><Color A="255" R="183" G="105" B="255" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BadgeMergedBrush"><SolidColorBrush.Color><Color A="255" R="183" G="105" B="255" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BadgeDraftBrush"><SolidColorBrush.Color><Color A="255" R="156" G="142" B="195" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BadgeNeutralBrush"><SolidColorBrush.Color><Color A="255" R="156" G="142" B="195" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BadgeFailureBrush"><SolidColorBrush.Color><Color A="255" R="255" G="80" B="120" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="BadgePendingBrush"><SolidColorBrush.Color><Color A="255" R="255" G="204" B="102" /></SolidColorBrush.Color></SolidColorBrush>

    <SolidColorBrush x:Key="LabelOrangeBrush"><SolidColorBrush.Color><Color A="255" R="255" G="143" B="71" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="LabelBlueBrush"><SolidColorBrush.Color><Color A="255" R="1" G="205" B="254" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="LabelTealBrush"><SolidColorBrush.Color><Color A="255" R="84" G="232" B="220" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="LabelRedBrush"><SolidColorBrush.Color><Color A="255" R="255" G="80" B="120" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="LabelPurpleBrush"><SolidColorBrush.Color><Color A="255" R="183" G="105" B="255" /></SolidColorBrush.Color></SolidColorBrush>
    <SolidColorBrush x:Key="LabelCyanBrush"><SolidColorBrush.Color><Color A="255" R="84" G="232" B="220" /></SolidColorBrush.Color></SolidColorBrush>

    <!-- ── Typography scale ─────────────────────────────────────── -->
    <s:Double x:Key="FontSizeXS">11</s:Double>
    <s:Double x:Key="FontSizeS">12</s:Double>
    <s:Double x:Key="FontSizeM">13</s:Double>
    <s:Double x:Key="FontSizeL">14</s:Double>
    <s:Double x:Key="FontSizeXL">15</s:Double>
    <s:Double x:Key="FontSizeH2">16</s:Double>
    <s:Double x:Key="FontSizeH1">18</s:Double>
</ResourceDictionary>
