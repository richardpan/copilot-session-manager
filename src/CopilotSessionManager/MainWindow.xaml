<Window x:Class="CopilotSessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding Title}"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12" Background="#181825">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding HeaderText}"
                           Foreground="#CDD6F4"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="24">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding WelcomeText}"
                           Foreground="#A6ADC8"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBlock Text="Sessions dashboard will appear here."
                           Foreground="#6C7086"
                           FontStyle="Italic"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="16,8" Background="#181825">
            <TextBlock Text="{Binding StatusBarText}"
                       Foreground="#7F849C"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
