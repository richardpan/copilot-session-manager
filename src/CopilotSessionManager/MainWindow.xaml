<Window x:Class="CopilotSessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding Title}"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Window.Resources>
        <DataTemplate x:Key="SessionCardTemplate" DataType="{x:Type vm:SessionCardViewModel}">
            <Border Margin="0,0,0,10"
                    Padding="14,12"
                    CornerRadius="6"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{Binding StatusBrush}"
                            CornerRadius="3"
                            Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#CDD6F4"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="640" />
                            <Border Background="{Binding StatusBrush}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Margin="10,2,0,0">
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="#11111B"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ShortId}"
                                       Foreground="#7F849C"
                                       FontFamily="Consolas"
                                       FontSize="11" />
                            <TextBlock Text=" • "
                                       Foreground="#585B70"
                                       FontSize="11" />
                            <TextBlock Text="{Binding Repository, FallbackValue='no repo'}"
                                       Foreground="#A6ADC8"
                                       FontSize="11" />
                            <TextBlock Text=" @ "
                                       Foreground="#585B70"
                                       FontSize="11" />
                            <TextBlock Text="{Binding Branch, FallbackValue='—'}"
                                       Foreground="#A6ADC8"
                                       FontSize="11" />
                        </StackPanel>

                        <TextBlock Text="{Binding Cwd}"
                                   Foreground="#6C7086"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding TurnCount, StringFormat='{}{0} turns'}"
                                   Foreground="#CDD6F4"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding UpdatedRelative}"
                                   Foreground="#7F849C"
                                   FontSize="11"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LockSummary}"
                                   Foreground="#7F849C"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12" Background="#181825">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding HeaderText}"
                           Foreground="#CDD6F4"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Padding="14,6"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        BorderBrush="#45475A"
                        Command="{Binding Sessions.RefreshCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="16,8" Background="#11111B">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Show inactive"
                          IsChecked="{Binding Sessions.ShowInactive}"
                          Foreground="#CDD6F4"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding Sessions.ActiveCount, StringFormat='{}{0} active'}"
                           Foreground="#A6E3A1"
                           Margin="20,0,8,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Sessions.TotalCount, StringFormat='of {0} total'}"
                           Foreground="#7F849C"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Padding="16" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sessions.VisibleSessions}"
                          ItemTemplate="{StaticResource SessionCardTemplate}" />
        </ScrollViewer>

        <Border Grid.Row="3" Padding="16,8" Background="#181825">
            <TextBlock Text="{Binding Sessions.StatusMessage}"
                       Foreground="#7F849C"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
