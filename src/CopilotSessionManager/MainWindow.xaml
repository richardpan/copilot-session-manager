<Window x:Class="CopilotSessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels"
        xmlns:v="clr-namespace:CopilotSessionManager.Views"
        xmlns:conv="clr-namespace:CopilotSessionManager.Converters"
        xmlns:models="clr-namespace:CopilotSessionManager.Core.Models;assembly=CopilotSessionManager.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding Title}"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <DataTemplate x:Key="LabelFilterTemplate" DataType="{x:Type vm:LabelFilterChip}">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="Toggle visibility of sessions with this label." />
        </DataTemplate>

        <DataTemplate x:Key="TierFilterTemplate" DataType="{x:Type vm:TierFilterChip}">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="Toggle visibility of sessions running models in this tier." />
        </DataTemplate>

        <DataTemplate x:Key="ProducerFilterTemplate" DataType="{x:Type vm:ProducerFilterChip}">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="Toggle visibility of sessions started by this Copilot client (e.g. agency, copilot-agent)." />
        </DataTemplate>

        <!--
            V1.5 (#116): Right-click context menu for each session row in the
            data-table layout. Same actions as the prior card context menu.
        -->
        <ContextMenu x:Key="SessionRowContextMenu">
            <MenuItem Header="Open in PowerShell"
                      Command="{Binding OpenCommand}"
                      AutomationProperties.Name="Open this session in a PowerShell window"
                      AutomationProperties.HelpText="Activates the existing PowerShell window for this session if one is open, otherwise launches a new one." />
            <MenuItem Header="Rename..."
                      Command="{Binding BeginRenameCommand}"
                      AutomationProperties.Name="Rename this session"
                      AutomationProperties.HelpText="Edits the display name shown for this session. Press Enter to save, Esc to cancel." />
            <MenuItem Header="Open SESSION-README"
                      Command="{Binding DataContext.Sessions.OpenReadmeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="Open SESSION-README" />
            <MenuItem Header="Open SESSION-DOCS (browser)"
                      Command="{Binding DataContext.Sessions.OpenDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="Open SESSION-DOCS in browser"
                      AutomationProperties.HelpText="Generates SESSION-DOCS.html from the user-curated SESSION-DOCS.md (scaffolding it on first use) and opens it in your default browser." />
            <Separator />
            <MenuItem Header="Star (pin to top)"
                      Command="{Binding ToggleStarCommand}"
                      AutomationProperties.Name="Toggle star" />
            <MenuItem Header="Set label">
                <MenuItem Header="Exploratory" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Exploratory}" />
                <MenuItem Header="Research" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Research}" />
                <MenuItem Header="Feature" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Feature}" />
                <MenuItem Header="Bug" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Bug}" />
                <MenuItem Header="Refactor" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Refactor}" />
                <MenuItem Header="Docs" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Docs}" />
                <MenuItem Header="Infra" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Infra}" />
                <MenuItem Header="Experiment" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Experiment}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Merge into..."
                      Command="{Binding MergeIntoCommand}"
                      AutomationProperties.Name="Merge this session into another"
                      AutomationProperties.HelpText="Opens the merge wizard to export this session via copilot --share and append it to a target session." />
            <Separator />
            <MenuItem Header="Delete from disk..."
                      Command="{Binding DeleteCommand}"
                      Foreground="{DynamicResource DangerBrush}"
                      AutomationProperties.Name="Delete session from disk"
                      AutomationProperties.HelpText="Permanently removes this session and all of its files. Shows a confirmation dialog first." />
        </ContextMenu>

        <!--
            V1.5 (#116) - DataGrid row style. Adds a 4 px status-coloured
            left-edge accent and a hover background. The accent reuses
            StatusBrush so colour-blind users still see StatusBadgeText
            in the Status column.
        -->
        <Style x:Key="SessionRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ContextMenu" Value="{StaticResource SessionRowContextMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="BorderBrush" Value="{Binding StatusBrush}" />
            <Setter Property="MinHeight" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top menu bar (Help → Onboarding…) -->
        <Menu Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="4,2">
            <MenuItem Header="_Help" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="Help menu">
                <MenuItem Header="_Onboarding…"
                          Command="{Binding OpenOnboardingCommand}"
                          ToolTip="Re-run the welcome flow and prerequisite checks."
                          AutomationProperties.Name="Re-run onboarding"
                          AutomationProperties.HelpText="Reopens the welcome flow and prerequisite checks." />
                <Separator />
                <MenuItem Header="Open _log folder"
                          Command="{Binding OpenLogFolderCommand}"
                          ToolTip="Open the per-user log folder in Explorer."
                          AutomationProperties.Name="Open log folder"
                          AutomationProperties.HelpText="Opens the per-user log folder in Windows Explorer." />
                <MenuItem Header="_Bundle logs for bug report…"
                          Command="{Binding BundleLogsCommand}"
                          ToolTip="Zip current log files for sharing in a bug report."
                          AutomationProperties.Name="Bundle logs for bug report"
                          AutomationProperties.HelpText="Zips current log files into a single archive for sharing in a bug report." />
                <Separator />
                <MenuItem Header="_Verbose logging"
                          IsCheckable="True"
                          IsChecked="{Binding IsVerboseLogging, Mode=TwoWay}"
                          Command="{Binding ToggleVerboseLoggingCommand}"
                          ToolTip="Switch between Information and Debug log level. Persisted."
                          AutomationProperties.Name="Verbose logging"
                          AutomationProperties.HelpText="Toggle between Information and Debug log level. The setting is persisted across restarts." />
            </MenuItem>
        </Menu>

        <!--
            GitHub availability banner (#84). Two stacked banners keep the
            visibility binding trivial (no multi-converter) and let each state
            carry its own colour palette + AutomationProperties text. Theme resources below keep the warning/error palettes centralized.
        -->
        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Visibility="{Binding ShowGitHubBanner, Converter={StaticResource BoolToVisibility}}">
            <Border Padding="16,8"
                    MinHeight="32"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="0,0,0,2"
                    Visibility="{Binding IsGitHubOffline, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="GitHub offline banner"
                    AutomationProperties.HelpText="Indicates the GitHub CLI cannot reach github.com. PR and issue enrichment are paused until connectivity returns.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding GitHubStatusMessage}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="16,8"
                    MinHeight="32"
                    Background="{DynamicResource DangerSurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="0,0,0,2"
                    Visibility="{Binding IsGitHubUnauthenticated, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="GitHub unauthenticated banner"
                    AutomationProperties.HelpText="Indicates the GitHub CLI is installed but not authenticated. Run gh auth login in PowerShell to enable PR and issue enrichment.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔒"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding GitHubStatusMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text=" — Run "
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="gh auth login"
                               Foreground="{DynamicResource DangerBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" in PowerShell."
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding HeaderText}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="＋ New session"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Background="{DynamicResource PrimaryActionBrush}"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            BorderBrush="{DynamicResource PrimaryActionBorderBrush}"
                            FontWeight="SemiBold"
                            ToolTipService.ShowDuration="25000"
                            AutomationProperties.Name="New Copilot session"
                            AutomationProperties.HelpText="Launches a fresh PowerShell window running copilot so the CLI mints a new session id."
                            Command="{Binding Sessions.NewSessionCommand}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Start a new Copilot session" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Launches a fresh PowerShell window in your user home and runs `copilot` (no --resume), so the CLI mints a brand-new session id." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="The new session appears in the dashboard within a few seconds — there's no need to refresh." />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="🧹 Clean stale locks"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Background="{DynamicResource OverlayBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            ToolTipService.ShowDuration="30000"
                            AutomationProperties.Name="Clean all stale locks"
                            AutomationProperties.HelpText="Sweeps the Copilot session-state folder and deletes inuse lock files left behind by dead processes."
                            Command="{Binding Sessions.CleanAllStaleLocksCommand}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="420">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Clean stale locks (all sessions)" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="The Copilot CLI writes a small file named inuse.&lt;pid&gt;.lock when a session starts and deletes it on a clean exit. If the CLI crashes, is force-killed, or the machine power-cycles, the lock can be left behind pointing at a process that is no longer running — Copilot then refuses to attach to that session." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="This button sweeps every session under ~/.copilot/session-state, checks each lock's PID, and deletes only the orphaned ones. Locks owned by a still-running process are never touched, so it is always safe to click — even with active sessions in other windows." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Per-session cleanup is also available via the 🧹 button on a crashed row, and ▶ Resume runs this same cleanup automatically before relaunching." />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="↻ Refresh"
                            Padding="12,6"
                            Background="{DynamicResource OverlayBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            ToolTipService.ShowDuration="20000"
                            AutomationProperties.Name="Refresh sessions"
                            AutomationProperties.HelpText="Re-scans the local Copilot session folder for new and updated sessions."
                            Command="{Binding Sessions.RefreshCommand}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="360">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Refresh" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Re-scans ~/.copilot/session-state for new and updated sessions and rebuilds the dashboard." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="The dashboard already updates automatically as sessions change on disk. Use this to force an immediate re-scan if a card looks out of sync." />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Single combined filter strip (V1.2 #108): show-inactive toggle,
             counts, label chips, and tier chips on one wrapping row instead
             of the prior 3-row stack. Tab order is left-to-right.
             V1.3 (#110): search box prepended for live name filtering. -->
        <Border Grid.Row="3" Padding="16,6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="0,1,0,0">
            <WrapPanel Orientation="Horizontal">
                <Border Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource OverlayBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="0,2,16,2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <Grid Width="200" VerticalAlignment="Center">
                            <TextBlock Text="Search by name…"
                                       Foreground="{DynamicResource TextPlaceholderBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sessions.SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding Sessions.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="12"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     KeyDown="OnSearchBoxKeyDown"
                                     ToolTip="Filter sessions by keywords in the name. Multiple words must all match. Esc clears."
                                     AutomationProperties.Name="Search sessions by name"
                                     AutomationProperties.HelpText="Type one or more keywords to filter the visible sessions by their display name. Multiple words are AND-matched. Press Esc to clear." />
                        </Grid>
                    </StackPanel>
                </Border>
                <CheckBox Content="Show inactive"
                          IsChecked="{Binding Sessions.ShowInactive}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,2,16,2"
                          AutomationProperties.Name="Show inactive sessions"
                          AutomationProperties.HelpText="When checked, the dashboard also lists sessions whose process is no longer running." />
                <TextBlock Text="{Binding Sessions.ActiveCount, StringFormat='{}{0} active'}"
                           Foreground="{DynamicResource SuccessBrush}"
                           VerticalAlignment="Center"
                           Margin="0,2,6,2"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Sessions.TotalCount, StringFormat='of {0} total'}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,2,16,2" />
                <TextBlock Text="Labels:"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,2,8,2" />
                <ItemsControl ItemsSource="{Binding Sessions.LabelFilters}"
                              ItemTemplate="{StaticResource LabelFilterTemplate}"
                              VerticalAlignment="Center"
                              Margin="0,2,8,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Tiers:"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,2,8,2" />
                <ItemsControl ItemsSource="{Binding Sessions.TierFilters}"
                              ItemTemplate="{StaticResource TierFilterTemplate}"
                              VerticalAlignment="Center"
                              Margin="0,2,8,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Producers:"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,2,8,2" />
                <ItemsControl ItemsSource="{Binding Sessions.ProducerFilters}"
                              ItemTemplate="{StaticResource ProducerFilterTemplate}"
                              VerticalAlignment="Center"
                              Margin="0,2,0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </WrapPanel>
        </Border>

        <!--
            V1.5 (#116) - Sortable, scannable data-table layout. Replaces the
            prior card grid. Each row has a 4 px status-coloured left edge
            (via SessionRowStyle.BorderBrush) so colour-blind users still get
            the StatusBadgeText pill in the Status column. Hover-revealed
            actions live in the Actions column. Right-click opens the same
            menu the cards used to expose.

            Keyboard navigation (#96): DataGrid supports Up/Down arrow row
            navigation natively (SelectionMode=Single + SelectionUnit=FullRow).
            The original #96 spec was written against the pre-V1.5
            ItemsControl-of-cards layout and is largely satisfied by the
            DataGrid migration. We add KeyboardNavigation.DirectionalNavigation
            ="Cycle" so Up at the first row wraps to the last and vice versa,
            matching the wrap-around behavior the original ListBox proposal
            would have given via the ListBox default.
        -->
        <DockPanel Grid.Row="4" LastChildFill="True">
            <Border DockPanel.Dock="Top"
                    Padding="12,8"
                    MinHeight="44"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource StatusCrashedBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding Sessions.CrashBanner.IsVisible, Converter={StaticResource BoolToVisibility}}"
                    KeyboardNavigation.TabNavigation="Local"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Crash notification"
                    AutomationProperties.HelpText="Notifies when one or more Copilot sessions crashed since the last scan.">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left"
                               Text="⚠"
                               Foreground="{DynamicResource StatusCrashedBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button Content="Clean up all"
                                Padding="12,4"
                                Margin="0,0,8,0"
                                Background="{DynamicResource PrimaryActionBrush}"
                                Foreground="{DynamicResource TextOnAccentBrush}"
                                BorderBrush="{DynamicResource PrimaryActionBorderBrush}"
                                FontWeight="SemiBold"
                                Command="{Binding Sessions.CrashBanner.CleanUpAllCommand}"
                                AutomationProperties.Name="Clean up all crashed sessions"
                                AutomationProperties.HelpText="Runs the existing clean stale locks action for all sessions." />
                        <Button Content="Dismiss"
                                Padding="12,4"
                                Background="{DynamicResource OverlayBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Command="{Binding Sessions.CrashBanner.DismissCommand}"
                                AutomationProperties.Name="Dismiss crash notification"
                                AutomationProperties.HelpText="Hides this crash notification for the current app session." />
                    </StackPanel>
                    <TextBlock Text="{Binding Sessions.CrashBanner.Message}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Padding="12,8"
                    MinHeight="56"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding OutdatedCliBanner.IsVisible, Converter={StaticResource BoolToVisibility}}"
                    KeyboardNavigation.TabNavigation="Local"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="CLI compatibility notification"
                    AutomationProperties.HelpText="Notifies when the GitHub or Copilot CLI version is missing or older than the supported minimum.">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left"
                               Text="⬆"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right"
                            Content="Dismiss"
                            Padding="12,4"
                            Margin="12,0,0,0"
                            Background="{DynamicResource OverlayBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Command="{Binding OutdatedCliBanner.DismissCommand}"
                            AutomationProperties.Name="Dismiss CLI compatibility notification"
                            AutomationProperties.HelpText="Hides this CLI compatibility notification for the current app session." />
                    <StackPanel>
                        <TextBlock Text="{Binding OutdatedCliBanner.Headline}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OutdatedCliBanner.UpgradeInstructions}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Sessions.VisibleSessions}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  KeyboardNavigation.DirectionalNavigation="Cycle"
                  EnableRowVirtualization="True"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderThickness="0"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  RowHeight="40"
                  RowStyle="{StaticResource SessionRowStyle}"
                  CellStyle="{StaticResource SessionCellStyle}"
                  ColumnHeaderStyle="{StaticResource SessionHeaderStyle}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  AutomationProperties.Name="Sessions table"
                  AutomationProperties.HelpText="Click any column header to sort. Right-click a row for actions. Hover a row to reveal inline actions. Use Up and Down arrow keys to move between rows; navigation cycles at the top and bottom.">
            <DataGrid.Columns>
                <!-- Star toggle. Sort by IsStarred desc puts starred first. -->
                <DataGridTemplateColumn Header="" Width="32" SortMemberPath="IsStarred" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ToggleStarCommand}"
                                    ToolTip="{Binding StarTooltip}"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Padding="4,0"
                                    FontSize="14"
                                    AutomationProperties.Name="Toggle star"
                                    AutomationProperties.HelpText="Star this session to pin it to the top of the dashboard.">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="☆" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                                <Setter Property="Content" Value="★" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Status pill: glyph + label, coloured by StatusBrush. -->
                <DataGridTemplateColumn Header="Status" Width="118" SortMemberPath="StatusLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusBrush}"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="{Binding StatusBadgeText}">
                                <TextBlock Text="{Binding StatusBadgeText}"
                                           Foreground="{DynamicResource TextOnAccentBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- V1.6 (#118): Actions moved left of Name and made always-visible.
                     Primary action is the prominent 📚 Docs button (text + accent
                     fill) which scaffolds + opens the per-session SESSION-DOCS.html
                     in the OS default browser. Other actions are icon-only. -->
                <DataGridTemplateColumn Header="" Width="220" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <Button Content="📚 Docs"
                                        Padding="10,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Margin="0,0,4,0"
                                        Background="{DynamicResource PrimaryActionBrush}"
                                        Foreground="{DynamicResource TextOnAccentBrush}"
                                        BorderBrush="{DynamicResource PrimaryActionBorderBrush}"
                                        BorderThickness="1"
                                        ToolTipService.ShowDuration="25000"
                                        Command="{Binding DataContext.Sessions.OpenDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Open session documentation">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="380">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Open session documentation" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Opens SESSION-DOCS.html for this session in your default browser. The page contains your hand-curated notes (Overview, Decisions, Features, Mockups, …) plus auto-derived indexes of files, plan, and checkpoints." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="On first click, csm scaffolds an empty SESSION-DOCS.md in the session folder for you (or your agent) to fill in. csm never overwrites your edits." />
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <Button Content="▶"
                                        Padding="6,0"
                                        FontSize="11"
                                        Margin="0,0,3,0"
                                        Background="Transparent"
                                        Foreground="{DynamicResource SuccessBrush}"
                                        BorderThickness="0"
                                        ToolTipService.ShowDuration="20000"
                                        Command="{Binding OpenCommand}"
                                        AutomationProperties.Name="Open this session in PowerShell">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="360">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Open in PowerShell" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Launches a new PowerShell window in the session's working directory and runs `copilot --resume &lt;id&gt;`." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="If a window for this session is already open, csm brings it to the foreground instead of launching a duplicate." />
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <Button Content="✎"
                                        Padding="5,0"
                                        FontSize="11"
                                        Margin="0,0,3,0"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderThickness="0"
                                        ToolTipService.ShowDuration="20000"
                                        Command="{Binding BeginRenameCommand}"
                                        AutomationProperties.Name="Rename">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="360">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Rename session" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Sets a custom display name for this session in csm. Press Enter to save, Esc to cancel; clearing the field restores the original Copilot-generated title." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="Renames are stored locally by csm and never modify the Copilot session itself, so the agent's own context is unaffected." />
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <Button Content="🧹"
                                        Padding="5,0"
                                        FontSize="11"
                                        Margin="0,0,3,0"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderThickness="0"
                                        ToolTipService.ShowDuration="30000"
                                        Visibility="{Binding IsCrashed, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding CleanupStaleLocksCommand}"
                                        AutomationProperties.Name="Clean stale lock files">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="420">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Clean stale locks" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="The Copilot CLI writes a small file named inuse.&lt;pid&gt;.lock when a session starts and deletes it on a clean exit. If the CLI crashes, is force-killed, or the machine power-cycles, the lock can be left behind pointing at a process that is no longer running — Copilot then refuses to attach to the session and the row is flagged as Crashed." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Text="This button walks every inuse.*.lock file in this session's folder, checks whether each owning PID is still alive, and deletes only the orphaned ones. Live locks are never touched, so it is always safe to click — even if you also have an active window for this session open elsewhere." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="The button only appears on Crashed rows. ▶ Resume runs this same cleanup automatically before relaunching, so most of the time you can skip straight to Resume." />
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <Button Content="▶ Resume"
                                        Padding="6,0"
                                        FontSize="11"
                                        Margin="0,0,3,0"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="{DynamicResource TextOnAccentBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        ToolTipService.ShowDuration="25000"
                                        Visibility="{Binding IsCrashed, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding ResumeCommand}"
                                        AutomationProperties.Name="Resume crashed session">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="380">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Resume crashed session" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Cleans up any stale inuse.*.lock files (locks owned by a process that is no longer running), then launches a fresh PowerShell window and reattaches to this session via `copilot --resume &lt;id&gt;`." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="A session is marked Crashed when csm finds an inuse lock pointing at a dead PID — usually after a CLI crash, force-kill, or power-loss." />
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <Button Content="🗑"
                                        Padding="5,0"
                                        FontSize="11"
                                        Background="Transparent"
                                        Foreground="{DynamicResource DangerBrush}"
                                        BorderThickness="0"
                                        ToolTipService.ShowDuration="25000"
                                        Command="{Binding DeleteCommand}"
                                        AutomationProperties.Name="Delete session from disk">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="380">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="Delete session from disk" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Permanently removes the session folder under ~/.copilot/session-state/&lt;id&gt;/ — including events, plan, checkpoints, and any files you've put under files/." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Text="csm also clears its own local overrides for this session (rename, star, GitHub link, README cache, generated SESSION-DOCS.html)." />
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Foreground="{DynamicResource DangerBrush}"
                                                           Text="This cannot be undone. csm asks for confirmation before deleting." />
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Name + repo·branch + label chip. Click name to inline-edit. -->
                <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="CardTitleText"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TitleTooltip}"
                                               Cursor="IBeam"
                                               MouseLeftButtonDown="OnCardTitleClicked"
                                               Visibility="{Binding IsEditingTitle, Converter={StaticResource InverseBoolToVisibility}}"
                                               AutomationProperties.Name="{Binding DisplayName}"
                                               AutomationProperties.HelpText="Click to rename this session." />
                                    <TextBox x:Name="CardTitleEditor"
                                             Text="{Binding EditableTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{DynamicResource TextOnAccentBrush}"
                                             Background="{DynamicResource AccentBrush}"
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             BorderThickness="1"
                                             BorderBrush="{DynamicResource AccentBrush}"
                                             Padding="2,0"
                                             MinWidth="180"
                                             Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}}"
                                             IsVisibleChanged="OnCardTitleEditorVisibilityChanged"
                                             KeyDown="OnCardTitleEditorKeyDown"
                                             LostKeyboardFocus="OnCardTitleEditorLostFocus"
                                             AutomationProperties.Name="Edit session name"
                                             AutomationProperties.HelpText="Press Enter to save the new name. Press Esc to cancel without saving." />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="{Binding LabelBrush}"
                                            CornerRadius="3"
                                            Padding="4,0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            ToolTip="Right-click to change label"
                                            AutomationProperties.Name="{Binding LabelText}"
                                            AutomationProperties.HelpText="Session label. Right-click to change.">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Exploratory" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Exploratory}" />
                                                <MenuItem Header="Research" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Research}" />
                                                <MenuItem Header="Feature" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Feature}" />
                                                <MenuItem Header="Bug" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Bug}" />
                                                <MenuItem Header="Refactor" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Refactor}" />
                                                <MenuItem Header="Docs" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Docs}" />
                                                <MenuItem Header="Infra" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Infra}" />
                                                <MenuItem Header="Experiment" Click="OnLabelMenuItemClicked" Tag="{x:Static models:SessionType.Experiment}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="White"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center">
                                        <Hyperlink Foreground="{DynamicResource PrimaryActionBrush}"
                                                   TextDecorations="None"
                                                   ToolTip="Open repository on GitHub"
                                                   Command="{Binding OpenUrlCommand}"
                                                   CommandParameter="{Binding RepositoryUrl}">
                                            <Run Text="{Binding Repository, FallbackValue='no repo', Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center">
                                        <Hyperlink Foreground="{DynamicResource PrimaryActionBrush}"
                                                   TextDecorations="None"
                                                   ToolTip="Open branch on GitHub"
                                                   Command="{Binding OpenUrlCommand}"
                                                   CommandParameter="{Binding BranchUrl}">
                                            <Run Text="{Binding Branch, FallbackValue='—', Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <Border Background="{Binding PullRequestStateBrush}"
                                            CornerRadius="3"
                                            Padding="4,0"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasPullRequest, Converter={StaticResource BoolToVisibility}}"
                                            Cursor="Hand"
                                            AutomationProperties.Name="{Binding PullRequestTooltip}">
                                        <Border.Style>
                                            <!-- Default tooltip describes the PR. When the parent VM reports
                                                 GitHub CLI is unauthenticated, swap to a remediation tooltip
                                                 pointing at `gh auth login` (#84). -->
                                            <Style TargetType="Border">
                                                <Setter Property="ToolTip" Value="{Binding PullRequestTooltip}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsGitHubUnauthenticated, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="ToolTip" Value="GitHub CLI not authenticated. Run `gh auth login` in PowerShell to enable PR actions." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding OpenUrlCommand}"
                                                          CommandParameter="{Binding PullRequestUrl}" />
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding PullRequestBadgeText}"
                                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="{Binding CheckBadgeBrush}"
                                            CornerRadius="3"
                                            Padding="4,0"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding CheckTooltip}"
                                            Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="{Binding CheckTooltip}">
                                        <TextBlock Text="{Binding CheckBadgeText}"
                                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Producer: agency / copilot-agent / (unknown). -->
                <DataGridTextColumn Header="Producer"
                                    Width="100"
                                    Binding="{Binding Producer, FallbackValue='—'}"
                                    SortMemberPath="Producer"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Tier badge. -->
                <DataGridTemplateColumn Header="Tier" Width="100" SortMemberPath="ModelTier">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding ModelTierBrush}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding ModelTooltip}"
                                    AutomationProperties.Name="{Binding ModelDisplay}"
                                    AutomationProperties.HelpText="{Binding ModelTooltip}">
                                <TextBlock Text="{Binding ModelDisplay}"
                                           Foreground="{DynamicResource TextOnAccentBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="84" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Turn count. -->
                <DataGridTextColumn Header="Turns"
                                    Width="60"
                                    Binding="{Binding TurnCount}"
                                    SortMemberPath="TurnCount"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Tokens (V1.5 NEW): aggregate across all models. -->
                <DataGridTextColumn Header="Tokens"
                                    Width="80"
                                    Binding="{Binding TokensDisplay}"
                                    SortMemberPath="TotalTokensRaw"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding TokensTooltip}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Updated (relative). -->
                <DataGridTextColumn Header="Updated"
                                    Width="100"
                                    Binding="{Binding UpdatedRelative}"
                                    SortMemberPath="UpdatedRelative"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Row="5" Padding="16,6" Background="{DynamicResource SurfaceBrush}">
            <TextBlock Text="{Binding Sessions.StatusMessage}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>


