<Window x:Class="CopilotSessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels"
        xmlns:models="clr-namespace:CopilotSessionManager.Core.Models;assembly=CopilotSessionManager.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding Title}"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Window.Resources>
        <DataTemplate x:Key="LabelFilterTemplate" DataType="{x:Type vm:LabelFilterChip}">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Foreground="#CDD6F4"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="TierFilterTemplate" DataType="{x:Type vm:TierFilterChip}">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Foreground="#CDD6F4"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="SessionCardTemplate" DataType="{x:Type vm:SessionCardViewModel}">
            <Border Margin="0,0,0,10"
                    Padding="14,12"
                    CornerRadius="6"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{Binding StatusBrush}"
                            CornerRadius="3"
                            Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#CDD6F4"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="540" />
                            <Border Background="{Binding StatusBrush}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Margin="10,2,0,0">
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="#11111B"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{Binding LabelBrush}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Margin="6,2,0,0"
                                    Cursor="Hand"
                                    ToolTip="Right-click to change label">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Exploratory"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Exploratory}" />
                                        <MenuItem Header="Research"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Research}" />
                                        <MenuItem Header="Feature"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Feature}" />
                                        <MenuItem Header="Bug"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Bug}" />
                                        <MenuItem Header="Refactor"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Refactor}" />
                                        <MenuItem Header="Docs"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Docs}" />
                                        <MenuItem Header="Infra"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Infra}" />
                                        <MenuItem Header="Experiment"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Experiment}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock Text="{Binding LabelText}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{Binding ModelTierBrush}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    Margin="6,2,0,0"
                                    ToolTip="{Binding ModelTooltip}">
                                <TextBlock Text="{Binding ModelDisplay}"
                                           Foreground="#11111B"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding ShortId}"
                                       Foreground="#7F849C"
                                       FontFamily="Consolas"
                                       FontSize="11" />
                            <TextBlock Text=" • "
                                       Foreground="#585B70"
                                       FontSize="11" />
                            <TextBlock Text="{Binding Repository, FallbackValue='no repo'}"
                                       Foreground="#A6ADC8"
                                       FontSize="11" />
                            <TextBlock Text=" @ "
                                       Foreground="#585B70"
                                       FontSize="11" />
                            <TextBlock Text="{Binding Branch, FallbackValue='—'}"
                                       Foreground="#A6ADC8"
                                       FontSize="11" />
                        </StackPanel>

                        <TextBlock Text="{Binding Cwd}"
                                   Foreground="#6C7086"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding TurnCount, StringFormat='{}{0} turns'}"
                                   Foreground="#CDD6F4"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CostDisplay}"
                                   Foreground="#F9E2AF"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   ToolTip="{Binding ModelTooltip}" />
                        <TextBlock Text="{Binding UpdatedRelative}"
                                   Foreground="#7F849C"
                                   FontSize="11"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LockSummary}"
                                   Foreground="#7F849C"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                        <Button Content="📄 README"
                                Margin="0,6,0,0"
                                Padding="8,3"
                                FontSize="11"
                                Background="#313244"
                                Foreground="#CDD6F4"
                                BorderBrush="#45475A"
                                ToolTip="Open the auto-generated SESSION-README.md for this session"
                                HorizontalAlignment="Right"
                                Command="{Binding DataContext.Sessions.OpenReadmeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12" Background="#181825">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding HeaderText}"
                           Foreground="#CDD6F4"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Padding="14,6"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        BorderBrush="#45475A"
                        Command="{Binding Sessions.RefreshCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="16,8" Background="#11111B">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Show inactive"
                          IsChecked="{Binding Sessions.ShowInactive}"
                          Foreground="#CDD6F4"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding Sessions.ActiveCount, StringFormat='{}{0} active'}"
                           Foreground="#A6E3A1"
                           Margin="20,0,8,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Sessions.TotalCount, StringFormat='of {0} total'}"
                           Foreground="#7F849C"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="16,6" Background="#11111B" BorderBrush="#181825" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Labels:"
                               Foreground="#7F849C"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ItemsControl ItemsSource="{Binding Sessions.LabelFilters}"
                                  ItemTemplate="{StaticResource LabelFilterTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Tiers:"
                               Foreground="#7F849C"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ItemsControl ItemsSource="{Binding Sessions.TierFilters}"
                                  ItemTemplate="{StaticResource TierFilterTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" Padding="16" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sessions.VisibleSessions}"
                          ItemTemplate="{StaticResource SessionCardTemplate}" />
        </ScrollViewer>

        <Border Grid.Row="4" Padding="16,8" Background="#181825">
            <TextBlock Text="{Binding Sessions.StatusMessage}"
                       Foreground="#7F849C"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
