<Window x:Class="CopilotSessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels"
        xmlns:v="clr-namespace:CopilotSessionManager.Views"
        xmlns:conv="clr-namespace:CopilotSessionManager.Converters"
        xmlns:models="clr-namespace:CopilotSessionManager.Core.Models;assembly=CopilotSessionManager.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding Title}"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <DataTemplate x:Key="LabelFilterTemplate" DataType="{x:Type vm:LabelFilterChip}">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Foreground="#CDD6F4"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="Toggle visibility of sessions with this label." />
        </DataTemplate>

        <DataTemplate x:Key="TierFilterTemplate" DataType="{x:Type vm:TierFilterChip}">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                      Foreground="#CDD6F4"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.HelpText="Toggle visibility of sessions running models in this tier." />
        </DataTemplate>

        <DataTemplate x:Key="SessionCardTemplate" DataType="{x:Type vm:SessionCardViewModel}">
            <Border Margin="0,0,0,6"
                    Padding="10,8"
                    CornerRadius="6"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.HelpText="Right-click for the merge menu. Use Tab to step through this card's actions."
                    KeyboardNavigation.TabNavigation="Local">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in PowerShell"
                                  Command="{Binding OpenCommand}"
                                  AutomationProperties.Name="Open this session in a PowerShell window"
                                  AutomationProperties.HelpText="Activates the existing PowerShell window for this session if one is open, otherwise launches a new one." />
                        <MenuItem Header="Rename…"
                                  Command="{Binding BeginRenameCommand}"
                                  AutomationProperties.Name="Rename this session"
                                  AutomationProperties.HelpText="Edits the display name shown for this session. Press Enter to save, Esc to cancel." />
                        <Separator />
                        <MenuItem Header="Merge into…"
                                  Command="{Binding MergeIntoCommand}"
                                  AutomationProperties.Name="Merge this session into another"
                                  AutomationProperties.HelpText="Opens the merge wizard to export this session via copilot --share and append it to a target session." />
                        <Separator />
                        <MenuItem Header="Delete from disk…"
                                  Command="{Binding DeleteCommand}"
                                  Foreground="#F38BA8"
                                  AutomationProperties.Name="Delete session from disk"
                                  AutomationProperties.HelpText="Permanently removes this session and all of its files. Shows a confirmation dialog first." />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{Binding StatusBrush}"
                            CornerRadius="2"
                            Margin="0,0,10,0"
                            ToolTip="{Binding LockSummary}" />

                    <StackPanel Grid.Column="1">
                        <!-- Title row + chips, wrapping when narrow. -->
                        <WrapPanel Orientation="Horizontal">
                            <Grid MaxWidth="540" Margin="0,0,8,2">
                                <TextBlock x:Name="CardTitleText"
                                           Text="{Binding DisplayName}"
                                           Foreground="#CDD6F4"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TitleTooltip}"
                                           Cursor="IBeam"
                                           MouseLeftButtonDown="OnCardTitleClicked"
                                           Visibility="{Binding IsEditingTitle, Converter={StaticResource InverseBoolToVisibility}}"
                                           AutomationProperties.Name="{Binding DisplayName}"
                                           AutomationProperties.HelpText="Click to rename this session." />
                                <TextBox x:Name="CardTitleEditor"
                                         Text="{Binding EditableTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="#11111B"
                                         Background="#F9E2AF"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         BorderThickness="1"
                                         BorderBrush="#F9E2AF"
                                         Padding="2,0"
                                         MinWidth="180"
                                         Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}}"
                                         IsVisibleChanged="OnCardTitleEditorVisibilityChanged"
                                         KeyDown="OnCardTitleEditorKeyDown"
                                         LostKeyboardFocus="OnCardTitleEditorLostFocus"
                                         AutomationProperties.Name="Edit session name"
                                         AutomationProperties.HelpText="Press Enter to save the new name. Press Esc to cancel without saving." />
                            </Grid>
                            <Border Background="{Binding StatusBrush}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="0,1,4,1"
                                    AutomationProperties.Name="{Binding StatusBadgeText}">
                                <TextBlock Text="{Binding StatusBadgeText}"
                                           Foreground="#11111B"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{Binding LabelBrush}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="0,1,4,1"
                                    Cursor="Hand"
                                    ToolTip="Right-click to change label"
                                    AutomationProperties.Name="{Binding LabelText}"
                                    AutomationProperties.HelpText="Session label. Right-click to change.">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Exploratory"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Exploratory}" />
                                        <MenuItem Header="Research"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Research}" />
                                        <MenuItem Header="Feature"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Feature}" />
                                        <MenuItem Header="Bug"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Bug}" />
                                        <MenuItem Header="Refactor"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Refactor}" />
                                        <MenuItem Header="Docs"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Docs}" />
                                        <MenuItem Header="Infra"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Infra}" />
                                        <MenuItem Header="Experiment"
                                                  Click="OnLabelMenuItemClicked"
                                                  Tag="{x:Static models:SessionType.Experiment}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock Text="{Binding LabelText}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{Binding ModelTierBrush}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="0,1,4,1"
                                    ToolTip="{Binding ModelTooltip}"
                                    AutomationProperties.Name="{Binding ModelDisplay}"
                                    AutomationProperties.HelpText="{Binding ModelTooltip}">
                                <TextBlock Text="{Binding ModelDisplay}"
                                           Foreground="#11111B"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{Binding PullRequestStateBrush}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="0,1,4,1"
                                    Visibility="{Binding HasPullRequest, Converter={StaticResource BoolToVisibility}}"
                                    Cursor="Hand"
                                    Focusable="True"
                                    AutomationProperties.Name="{Binding PullRequestTooltip}"
                                    AutomationProperties.HelpText="Press Enter to open this pull request in your browser.">
                                <Border.Style>
                                    <!-- Default tooltip describes the PR. When the parent VM reports
                                         GitHub CLI is unauthenticated, swap to a remediation tooltip
                                         pointing at `gh auth login` (#84). -->
                                    <Style TargetType="Border">
                                        <Setter Property="ToolTip" Value="{Binding PullRequestTooltip}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsGitHubUnauthenticated, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="ToolTip" Value="GitHub CLI not authenticated. Run `gh auth login` in PowerShell to enable PR actions." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding OpenUrlCommand}"
                                                  CommandParameter="{Binding PullRequestUrl}" />
                                    <KeyBinding Key="Enter"
                                                Command="{Binding OpenUrlCommand}"
                                                CommandParameter="{Binding PullRequestUrl}" />
                                    <KeyBinding Key="Space"
                                                Command="{Binding OpenUrlCommand}"
                                                CommandParameter="{Binding PullRequestUrl}" />
                                </Border.InputBindings>
                                <TextBlock Text="{Binding PullRequestBadgeText}"
                                           Foreground="#11111B"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{Binding CheckBadgeBrush}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,1,4,1"
                                    ToolTip="{Binding CheckTooltip}"
                                    Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="{Binding CheckTooltip}">
                                <TextBlock Text="{Binding CheckBadgeText}"
                                           Foreground="#11111B"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </WrapPanel>

                        <!-- Single meta line: id · repo @ branch · cwd. -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding ShortId}"
                                       Foreground="#7F849C"
                                       FontFamily="Consolas"
                                       FontSize="11" />
                            <TextBlock Text=" · "
                                       Foreground="#7F849C"
                                       FontSize="11" />
                            <TextBlock Foreground="#A6ADC8" FontSize="11">
                                <Hyperlink Foreground="#89B4FA"
                                           TextDecorations="None"
                                           ToolTip="Open repository on GitHub"
                                           Command="{Binding OpenUrlCommand}"
                                           CommandParameter="{Binding RepositoryUrl}">
                                    <Run Text="{Binding Repository, FallbackValue='no repo', Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text=" @ "
                                       Foreground="#7F849C"
                                       FontSize="11" />
                            <TextBlock Foreground="#A6ADC8" FontSize="11">
                                <Hyperlink Foreground="#89B4FA"
                                           TextDecorations="None"
                                           Command="{Binding OpenUrlCommand}"
                                           CommandParameter="{Binding BranchUrl}">
                                    <Hyperlink.Style>
                                        <Style TargetType="Hyperlink">
                                            <Setter Property="ToolTip" Value="Open branch on GitHub" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsGitHubUnauthenticated, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="ToolTip" Value="GitHub CLI not authenticated. Run `gh auth login` in PowerShell to enable branch actions." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Hyperlink.Style>
                                    <Run Text="{Binding Branch, FallbackValue='—', Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text=" · "
                                       Foreground="#7F849C"
                                       FontSize="11" />
                            <TextBlock Text="{Binding Cwd}"
                                       Foreground="#6C7086"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="420"
                                       ToolTip="{Binding Cwd}" />
                        </StackPanel>

                        <v:IssueLinksPanel DataContext="{Binding IssueLinks}"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding IssueLinks, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0">
                        <!-- Compact metrics: turns · cost · updated. Tooltip carries the full model name. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TurnCount, StringFormat='{}{0} turns'}"
                                       Foreground="#CDD6F4"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CostDisplay}"
                                       Foreground="#F9E2AF"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"
                                       ToolTip="{Binding ModelTooltip}" />
                            <TextBlock Text="{Binding UpdatedRelative}"
                                       Foreground="#7F849C"
                                       FontSize="11" />
                        </StackPanel>
                        <!-- Action row: README + Open side-by-side. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,0,0">
                            <Button Content="📄"
                                    Padding="6,2"
                                    FontSize="11"
                                    Margin="0,0,4,0"
                                    Background="#313244"
                                    Foreground="#CDD6F4"
                                    BorderBrush="#45475A"
                                    ToolTip="Open the auto-generated SESSION-README.md for this session"
                                    AutomationProperties.Name="Open SESSION-README"
                                    AutomationProperties.HelpText="Opens the auto-generated SESSION-README.md for this session in the OS default markdown viewer."
                                    Command="{Binding DataContext.Sessions.OpenReadmeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="▶ Open"
                                    Padding="8,2"
                                    FontSize="11"
                                    Background="#89B4FA"
                                    Foreground="#11111B"
                                    BorderBrush="#74A0E0"
                                    ToolTip="Open this session in PowerShell. If a window for this session is already open, it is brought to the foreground."
                                    AutomationProperties.Name="Open this session in PowerShell"
                                    AutomationProperties.HelpText="Activates the existing PowerShell window for this session if one is open, otherwise launches a new one."
                                    Command="{Binding OpenCommand}" />
                        </StackPanel>
                        <!-- Crashed-only actions: stay on a separate row so they only appear when needed. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding IsCrashed, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="▶ Resume"
                                    Padding="8,2"
                                    FontSize="11"
                                    Margin="0,0,4,0"
                                    Background="#A6E3A1"
                                    Foreground="#11111B"
                                    BorderBrush="#94D396"
                                    ToolTip="Launch a new PowerShell window and resume this Copilot session (cleans up stale lock files first)"
                                    AutomationProperties.Name="Resume crashed session"
                                    AutomationProperties.HelpText="Cleans stale lock files and launches a new PowerShell window that resumes this Copilot session."
                                    Command="{Binding ResumeCommand}" />
                            <Button Content="🧹"
                                    Padding="6,2"
                                    FontSize="11"
                                    Background="#313244"
                                    Foreground="#CDD6F4"
                                    BorderBrush="#45475A"
                                    ToolTip="Delete stale inuse.*.lock files for this crashed session"
                                    AutomationProperties.Name="Clean up stale lock files"
                                    AutomationProperties.HelpText="Deletes inuse.*.lock files left behind by a crashed Copilot process for this session."
                                    Command="{Binding CleanupStaleLocksCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top menu bar (Help → Onboarding…) -->
        <Menu Grid.Row="0" Background="#11111B" Foreground="#CDD6F4" Padding="4,2">
            <MenuItem Header="_Help" Foreground="#CDD6F4" AutomationProperties.Name="Help menu">
                <MenuItem Header="_Onboarding…"
                          Command="{Binding OpenOnboardingCommand}"
                          ToolTip="Re-run the welcome flow and prerequisite checks."
                          AutomationProperties.Name="Re-run onboarding"
                          AutomationProperties.HelpText="Reopens the welcome flow and prerequisite checks." />
                <Separator />
                <MenuItem Header="Open _log folder"
                          Command="{Binding OpenLogFolderCommand}"
                          ToolTip="Open the per-user log folder in Explorer."
                          AutomationProperties.Name="Open log folder"
                          AutomationProperties.HelpText="Opens the per-user log folder in Windows Explorer." />
                <MenuItem Header="_Bundle logs for bug report…"
                          Command="{Binding BundleLogsCommand}"
                          ToolTip="Zip current log files for sharing in a bug report."
                          AutomationProperties.Name="Bundle logs for bug report"
                          AutomationProperties.HelpText="Zips current log files into a single archive for sharing in a bug report." />
                <Separator />
                <MenuItem Header="_Verbose logging"
                          IsCheckable="True"
                          IsChecked="{Binding IsVerboseLogging, Mode=TwoWay}"
                          Command="{Binding ToggleVerboseLoggingCommand}"
                          ToolTip="Switch between Information and Debug log level. Persisted."
                          AutomationProperties.Name="Verbose logging"
                          AutomationProperties.HelpText="Toggle between Information and Debug log level. The setting is persisted across restarts." />
            </MenuItem>
        </Menu>

        <!--
            GitHub availability banner (#84). Two stacked banners keep the
            visibility binding trivial (no multi-converter) and let each state
            carry its own colour palette + AutomationProperties text. Inline
            hex colours below — TODO: replace with named brushes once #95
            (palette extraction to App.xaml resources) lands.
        -->
        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Visibility="{Binding ShowGitHubBanner, Converter={StaticResource BoolToVisibility}}">
            <Border Padding="16,8"
                    MinHeight="32"
                    Background="#3D2C0E"
                    BorderBrush="#F9E2AF"
                    BorderThickness="0,0,0,2"
                    Visibility="{Binding IsGitHubOffline, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="GitHub offline banner"
                    AutomationProperties.HelpText="Indicates the GitHub CLI cannot reach github.com. PR and issue enrichment are paused until connectivity returns.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠"
                               Foreground="#F9E2AF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding GitHubStatusMessage}"
                               Foreground="#F9E2AF"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="16,8"
                    MinHeight="32"
                    Background="#3D1F26"
                    BorderBrush="#F38BA8"
                    BorderThickness="0,0,0,2"
                    Visibility="{Binding IsGitHubUnauthenticated, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="GitHub unauthenticated banner"
                    AutomationProperties.HelpText="Indicates the GitHub CLI is installed but not authenticated. Run gh auth login in PowerShell to enable PR and issue enrichment.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔒"
                               Foreground="#F38BA8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding GitHubStatusMessage}"
                               Foreground="#F38BA8"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text=" — Run "
                               Foreground="#F38BA8"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="gh auth login"
                               Foreground="#F38BA8"
                               FontFamily="Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" in PowerShell."
                               Foreground="#F38BA8"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Padding="16,8" Background="#181825">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding HeaderText}"
                           Foreground="#CDD6F4"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="＋ New session"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Background="#89B4FA"
                            Foreground="#11111B"
                            BorderBrush="#74A0E0"
                            FontWeight="SemiBold"
                            ToolTip="Launch a fresh PowerShell window running `copilot` (no --resume). The new session appears in the list within a few seconds."
                            AutomationProperties.Name="New Copilot session"
                            AutomationProperties.HelpText="Launches a fresh PowerShell window running copilot so the CLI mints a new session id."
                            Command="{Binding Sessions.NewSessionCommand}" />
                    <Button Content="🧹 Clean stale locks"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Background="#313244"
                            Foreground="#CDD6F4"
                            BorderBrush="#45475A"
                            ToolTip="Sweep ~/.copilot/session-state and delete inuse.*.lock files whose owning process is no longer running"
                            AutomationProperties.Name="Clean all stale locks"
                            AutomationProperties.HelpText="Sweeps the Copilot session-state folder and deletes inuse lock files left behind by dead processes."
                            Command="{Binding Sessions.CleanAllStaleLocksCommand}" />
                    <Button Content="↻ Refresh"
                            Padding="12,6"
                            Background="#313244"
                            Foreground="#CDD6F4"
                            BorderBrush="#45475A"
                            AutomationProperties.Name="Refresh sessions"
                            AutomationProperties.HelpText="Re-scans the local Copilot session folder for new and updated sessions."
                            Command="{Binding Sessions.RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Single combined filter strip (V1.2 #108): show-inactive toggle,
             counts, label chips, and tier chips on one wrapping row instead
             of the prior 3-row stack. Tab order is left-to-right. -->
        <Border Grid.Row="3" Padding="16,6" Background="#11111B" BorderBrush="#181825" BorderThickness="0,1,0,0">
            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Show inactive"
                          IsChecked="{Binding Sessions.ShowInactive}"
                          Foreground="#CDD6F4"
                          VerticalAlignment="Center"
                          Margin="0,2,16,2"
                          AutomationProperties.Name="Show inactive sessions"
                          AutomationProperties.HelpText="When checked, the dashboard also lists sessions whose process is no longer running." />
                <TextBlock Text="{Binding Sessions.ActiveCount, StringFormat='{}{0} active'}"
                           Foreground="#A6E3A1"
                           VerticalAlignment="Center"
                           Margin="0,2,6,2"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Sessions.TotalCount, StringFormat='of {0} total'}"
                           Foreground="#7F849C"
                           VerticalAlignment="Center"
                           Margin="0,2,16,2" />
                <TextBlock Text="Labels:"
                           Foreground="#7F849C"
                           VerticalAlignment="Center"
                           Margin="0,2,8,2" />
                <ItemsControl ItemsSource="{Binding Sessions.LabelFilters}"
                              ItemTemplate="{StaticResource LabelFilterTemplate}"
                              VerticalAlignment="Center"
                              Margin="0,2,8,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Tiers:"
                           Foreground="#7F849C"
                           VerticalAlignment="Center"
                           Margin="0,2,8,2" />
                <ItemsControl ItemsSource="{Binding Sessions.TierFilters}"
                              ItemTemplate="{StaticResource TierFilterTemplate}"
                              VerticalAlignment="Center"
                              Margin="0,2,0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="4" Padding="16,8" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sessions.VisibleSessions}"
                          ItemTemplate="{StaticResource SessionCardTemplate}" />
        </ScrollViewer>

        <Border Grid.Row="5" Padding="16,6" Background="#181825">
            <TextBlock Text="{Binding Sessions.StatusMessage}"
                       Foreground="#7F849C"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
