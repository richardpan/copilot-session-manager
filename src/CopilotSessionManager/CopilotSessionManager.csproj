<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CopilotSessionManager.Core\CopilotSessionManager.Core.csproj" />
    <ProjectReference Include="..\CopilotSessionManager.Native\CopilotSessionManager.Native.csproj" />
    <ProjectReference Include="..\CopilotSessionManager.Terminal\CopilotSessionManager.Terminal.csproj" />
    <ProjectReference Include="..\CopilotSessionManager.Terminal.Hosting\CopilotSessionManager.Terminal.Hosting.csproj" />
    <ProjectReference Include="..\CopilotSessionManager.Terminal.Wpf\CopilotSessionManager.Terminal.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!--
    UseWindowsForms enables a tray icon (NotifyIcon) but its implicit usings
    (System.Drawing, System.Windows.Forms) collide with WPF's System.Windows
    namespace on common type names like Application and Brush. The tray
    service file imports those namespaces explicitly, so strip the implicit
    ones to keep the rest of the codebase unambiguous.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
