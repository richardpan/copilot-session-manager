<Window x:Class="CopilotSessionManager.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels"
        xmlns:onboard="clr-namespace:CopilotSessionManager.Core.Onboarding;assembly=CopilotSessionManager.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
        Title="Welcome — Copilot Session Manager"
        Height="560"
        Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E2E">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource StepButton}">
            <Setter Property="Background" Value="#89B4FA" />
            <Setter Property="Foreground" Value="#11111B" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Stepper header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Foreground="#A6ADC8"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,12,0">
                <Run Text="STEP" />
                <Run Text="{Binding StepNumber, FallbackValue='1', Mode=OneWay}" />
                <Run Text="OF 3" />
            </TextBlock>
            <Border Width="180" Height="4" CornerRadius="2" Background="#313244" VerticalAlignment="Center">
                <Border Background="#89B4FA"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Width="{Binding ProgressWidth, FallbackValue=60, Mode=OneWay}" />
            </Border>
        </StackPanel>

        <!-- Step content -->
        <Grid Grid.Row="1">
            <!-- Step 1: Welcome -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:OnboardingStep.Welcome}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Welcome to Copilot Session Manager"
                           Foreground="#CDD6F4"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <TextBlock Foreground="#A6ADC8"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,16">
                    Manage every GitHub Copilot CLI session from one dashboard. Track tokens,
                    cost, status, and READMEs across all your active and recent sessions.
                </TextBlock>
                <Border Background="#181825" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="What we'll do next:"
                                   Foreground="#CDD6F4"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Foreground="#A6ADC8" FontSize="12" Margin="0,2,0,0">• Check that PowerShell, the Copilot CLI, and the gh CLI are installed.</TextBlock>
                        <TextBlock Foreground="#A6ADC8" FontSize="12" Margin="0,2,0,0">• Confirm you can access the local Copilot session folder.</TextBlock>
                        <TextBlock Foreground="#A6ADC8" FontSize="12" Margin="0,2,0,0">• Show you the existing sessions we'll auto-discover.</TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Foreground="#7F849C"
                           FontSize="11"
                           FontStyle="Italic"
                           TextWrapping="Wrap">
                    You can re-open this any time from the Help menu.
                </TextBlock>
            </StackPanel>

            <!-- Step 2: Prerequisites -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:OnboardingStep.Prerequisites}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="System checks"
                               Foreground="#CDD6F4"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Click 'Install' to open install instructions, then come back and re-check."
                               Foreground="#A6ADC8"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PrerequisiteResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrerequisiteResultViewModel}">
                                <Border Margin="0,0,0,6"
                                        Padding="10,8"
                                        Background="#181825"
                                        BorderBrush="#313244"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusGlyph}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A6ADC8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static onboard:PrerequisiteStatus.Ok}">
                                                            <Setter Property="Foreground" Value="#A6E3A1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static onboard:PrerequisiteStatus.Warning}">
                                                            <Setter Property="Foreground" Value="#F9E2AF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static onboard:PrerequisiteStatus.Failed}">
                                                            <Setter Property="Foreground" Value="#F38BA8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#CDD6F4"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="#A6ADC8"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Install"
                                                Padding="10,4"
                                                Margin="8,0,0,0"
                                                Background="#313244"
                                                Foreground="#CDD6F4"
                                                BorderBrush="#45475A"
                                                Visibility="{Binding HasInstallUrl, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.OpenInstallUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding InstallUrl}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="🔄 Re-check"
                            Style="{StaticResource StepButton}"
                            Margin="0"
                            IsEnabled="{Binding CanRecheck}"
                            Command="{Binding RecheckPrerequisitesCommand}" />
                    <TextBlock Text="Checking…"
                               Foreground="#A6ADC8"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding IsCheckingPrerequisites, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- Step 3: Adoption -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:OnboardingStep.Adoption}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Existing sessions"
                           Foreground="#CDD6F4"
                           FontSize="20"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Margin="0,4,0,12" TextWrapping="Wrap">
                    <Run Text="We found" Foreground="#A6ADC8" FontSize="13" />
                    <Run Text="{Binding ExistingSessionCount, Mode=OneWay}" Foreground="#89B4FA" FontSize="13" FontWeight="SemiBold" />
                    <Run Text="existing session(s) and will load them automatically." Foreground="#A6ADC8" FontSize="13" />
                </TextBlock>

                <Border Grid.Row="2"
                        Background="#181825"
                        BorderBrush="#313244"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AdoptionPreview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdoptedSessionPreview}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ShortId}"
                                                   Foreground="#7F849C"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Margin="0,2,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#CDD6F4"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Repository}"
                                                       Foreground="#7F849C"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Skip"
                    Style="{StaticResource StepButton}"
                    Command="{Binding SkipCommand}" />
            <Button Command="{Binding BackCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource StepButton}">
                        <Setter Property="Content" Value="Back" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:OnboardingStep.Welcome}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding NextCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Content" Value="Next" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:OnboardingStep.Adoption}">
                                <Setter Property="Content" Value="Open dashboard" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
