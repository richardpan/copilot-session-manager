<UserControl x:Class="CopilotSessionManager.Views.Terminal.TerminalTabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels.Terminal"
             xmlns:terminal="clr-namespace:CopilotSessionManager.Terminal.Wpf;assembly=CopilotSessionManager.Terminal.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TerminalTabsViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="900"
             Background="#1E1E1E"
             Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!--
        Phase 6C (#159): Ctrl+Tab / Ctrl+Shift+Tab cycle the active tab.
        The bindings target the UserControl's DataContext so they fire
        only while focus lives inside the embedded terminal surface.
        Standard TabControl Ctrl+Tab handling is suppressed by routing
        the gesture through these commands.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="Tab"
                    Modifiers="Control"
                    Command="{Binding CycleNextCommand}" />
        <KeyBinding Key="Tab"
                    Modifiers="Control+Shift"
                    Command="{Binding CyclePreviousCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <!--
            Phase 6A scaffolding (issue #159): a stock TabControl bound to
            the view-model's Tabs / ActiveTab. Header template uses the
            per-tab tier accent + display name. Content template hosts one
            TerminalControl per tab, buffer bound to the tab's
            TerminalSession.Buffer.

            Phase 6C polish:
              * Close glyph (×) on each header bound to CloseTabCommand.
              * Middle-click on a tab header closes the tab (code-behind).
              * Ctrl+Tab / Ctrl+Shift+Tab cycle the active tab.
        -->
        <TabControl x:Name="Tabs"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                    Background="#1E1E1E"
                    BorderBrush="#3F3F46"
                    BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <EventSetter Event="MouseDown" Handler="OnTabItemMouseDown" />
                </Style>
            </TabControl.Resources>
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalTabViewModel}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6"
                                Height="14"
                                Margin="0,0,8,0"
                                CornerRadius="2"
                                Background="{Binding TierAccent}" />
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Foreground="#DCDCDC" />
                        <Button x:Name="CloseButton"
                                Margin="8,0,0,0"
                                Padding="4,0"
                                MinWidth="18"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Foreground="#9F9F9F"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Focusable="False"
                                Content="&#x2715;"
                                ToolTip="Close tab (middle-click also works)"
                                AutomationProperties.Name="Close terminal tab"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="2"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#5A1D1D" />
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalTabViewModel}">
                    <Border BorderBrush="#3F3F46"
                            BorderThickness="0,1,0,0"
                            Background="#0C0C0C">
                        <terminal:TerminalControl FontFamily="Cascadia Mono, Consolas, Lucida Console, Courier New"
                                                  FontSize="14"
                                                  Background="#0C0C0C"
                                                  Foreground="#DCDCDC"
                                                  Buffer="{Binding TerminalSession.Buffer}" />
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Empty-state hint when no tabs are open. Phase 6B will replace this with the legacy launcher's CTA. -->
        <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#7F7F7F"
                   FontStyle="Italic"
                   Text="No embedded terminals open. Click Open Terminal on a session card to add one." />
    </Grid>
</UserControl>
