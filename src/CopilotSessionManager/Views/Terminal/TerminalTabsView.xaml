<UserControl x:Class="CopilotSessionManager.Views.Terminal.TerminalTabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels.Terminal"
             xmlns:terminal="clr-namespace:CopilotSessionManager.Terminal.Wpf;assembly=CopilotSessionManager.Terminal.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TerminalTabsViewModel}"
             d:DesignHeight="320"
             d:DesignWidth="900"
             Background="{DynamicResource SurfaceBrush}"
             Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!--
        Phase 6C (#159): Ctrl+Tab / Ctrl+Shift+Tab cycle the active tab.
        The bindings target the UserControl's DataContext so they fire
        only while focus lives inside the embedded terminal surface.
        Standard TabControl Ctrl+Tab handling is suppressed by routing
        the gesture through these commands.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="Tab"
                    Modifiers="Control"
                    Command="{Binding CycleNextCommand}" />
        <KeyBinding Key="Tab"
                    Modifiers="Control+Shift"
                    Command="{Binding CyclePreviousCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <!--
            Phase 6A scaffolding (issue #159): a stock TabControl bound to
            the view-model's Tabs / ActiveTab. Header template uses the
            per-tab tier accent + display name. Content template hosts one
            TerminalControl per tab, buffer bound to the tab's
            TerminalSession.Buffer.

            Phase 6C polish:
              * Close glyph (×) on each header bound to CloseTabCommand.
              * Middle-click on a tab header closes the tab (code-behind).
              * Ctrl+Tab / Ctrl+Shift+Tab cycle the active tab.
        -->
        <TabControl x:Name="Tabs"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <EventSetter Event="MouseDown" Handler="OnTabItemMouseDown" />
                </Style>
                <!--
                    Phase 5 of #93: right-click context menu on the tab
                    header. "Detach to external window" tears down the
                    embedded ConPTY and re-launches the session in an
                    external PowerShell window (the legacy launcher).
                    DetachTabCommand auto-disables itself when the host
                    has not wired the detach callback. The menu is
                    parented to a sentinel TextBlock so we can reach the
                    TabControl's DataContext (the TerminalTabsViewModel)
                    via PlacementTarget rather than the tab's own
                    DataContext (the TerminalTabViewModel).
                -->
                <ContextMenu x:Key="TabHeaderContextMenu">
                    <MenuItem Header="Detach to external window"
                              Command="{Binding PlacementTarget.Tag.DetachTabCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="Detach this terminal tab to an external PowerShell window"
                              AutomationProperties.HelpText="Closes the embedded terminal tab and re-launches the session in a standalone PowerShell window. The dashboard session itself is unaffected." />
                    <MenuItem Header="Close tab"
                              Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="Close this terminal tab"
                              AutomationProperties.HelpText="Closes the embedded terminal tab. Same as middle-clicking the tab header or clicking the X glyph." />
                </ContextMenu>
            </TabControl.Resources>
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalTabViewModel}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ContextMenu="{StaticResource TabHeaderContextMenu}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}">
                        <Border Width="6"
                                Height="14"
                                Margin="0,0,8,0"
                                CornerRadius="2"
                                Background="{Binding TierAccent}" />
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button x:Name="CloseButton"
                                Margin="8,0,0,0"
                                Padding="4,0"
                                MinWidth="18"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="14"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Focusable="False"
                                Content="&#x2715;"
                                ToolTip="Close tab (middle-click also works)"
                                AutomationProperties.Name="Close terminal tab"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="2"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:TerminalTabViewModel}">
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Background="{DynamicResource SurfaceBrush}">
                        <terminal:TerminalControl x:Name="EmbeddedTerminal"
                                                  FontFamily="Cascadia Mono, Consolas, Lucida Console, Courier New"
                                                  FontSize="16"
                                                  Background="#0D1117"
                                                  Foreground="#E6EDF3"
                                                  Buffer="{Binding TerminalSession.Buffer}"
                                                  Loaded="OnEmbeddedTerminalLoaded"
                                                  Unloaded="OnEmbeddedTerminalUnloaded"
                                                  SizeChanged="OnEmbeddedTerminalSizeChanged" />
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Empty-state hint when no tabs are open. Phase 6B will replace this with the legacy launcher's CTA. -->
        <TextBlock Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPlaceholderBrush}"
                   FontStyle="Italic"
                   Text="No embedded terminals open. Click Open Terminal on a session card to add one." />
    </Grid>
</UserControl>
