<Window x:Class="CopilotSessionManager.Views.MergeWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels.Merge"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MergeWizardViewModel}"
        Title="Merge session…"
        Height="540"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        </Style>

        <DataTemplate x:Key="CandidateTemplate" DataType="{x:Type vm:MergeTargetCandidateViewModel}">
            <Border Margin="0,0,0,4"
                    Padding="10,8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OverlayBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0"
                                 GroupName="MergeTargets"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 AutomationProperties.Name="{Binding Title}"
                                 AutomationProperties.HelpText="Select this session as the merge target." />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RecencyDescription}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20" FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Merge session"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="14"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap">
                <Run Text="From " />
                <Run Text="{Binding SourceTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Run Text=" (" />
                <Run Text="{Binding SourceShortId, Mode=OneWay}" FontFamily="Consolas" />
                <Run Text=")" />
            </TextBlock>
        </StackPanel>

        <!-- Step content -->
        <Grid Grid.Row="1">

            <!-- Step 1: PickTarget -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.PickTarget}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Pick a target session to merge into:"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="SearchBox"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Padding="6,4"
                             ToolTip="Search by title, repo, branch, or session id."
                             AutomationProperties.Name="Search target sessions"
                             AutomationProperties.HelpText="Filters the candidate list by title, repository, branch, or session id." />
                    <CheckBox Grid.Column="1"
                              Content="Show inactive"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0"
                              IsChecked="{Binding ShowInactiveTargets, Mode=TwoWay}"
                              AutomationProperties.Name="Show inactive targets"
                              AutomationProperties.HelpText="When checked, the candidate list also includes sessions whose process is no longer running." />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TargetCandidates}"
                                      ItemTemplate="{StaticResource CandidateTemplate}" />
                        <TextBlock Text="No matching sessions. Try clearing the search or showing inactive sessions."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetCandidates.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="3"
                           Text="The export step calls 'copilot --share' on the source session. This may take a few seconds."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="13"
                           FontStyle="Italic"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- Step 2: PreviewAndConfirm -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.PreviewAndConfirm}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource OverlayBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                            <Run Text="Source: " />
                            <Run Text="{Binding SourceTitle, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <Run Text=" (" />
                            <Run Text="{Binding SourceShortId, Mode=OneWay}" FontFamily="Consolas" />
                            <Run Text=")" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0">
                            <Run Text="Target: " />
                            <Run Text="{Binding TargetTitle, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <Run Text=" (" />
                            <Run Text="{Binding TargetShortId, Mode=OneWay}" FontFamily="Consolas" />
                            <Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="Markdown preview (this will be appended to the target session):"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,4" />

                <TextBox Grid.Row="2"
                         Text="{Binding MarkdownPreview, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="14"
                         Background="{DynamicResource SurfaceAltBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource OverlayBrush}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap" />
            </Grid>

            <!-- Step 3: Running -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.Running}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar IsIndeterminate="True"
                             Height="6"
                             Width="320"
                             Foreground="{DynamicResource PrimaryActionBrush}"
                             Background="{DynamicResource OverlayBrush}"
                             BorderThickness="0" />
                <TextBlock Text="{Binding ProgressMessage}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>

            <!-- Step 4: Done -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.Done}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock HorizontalAlignment="Center"
                           FontSize="42"
                           FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✗" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Text" Value="✓" />
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DoneSummary}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="540"
                           Margin="0,16,0,0" />
                <Button Content="Open merged file"
                        Style="{StaticResource WizardButton}"
                        Command="{Binding OpenMergedFileCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,18,0,0"
                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Open merged file"
                        AutomationProperties.HelpText="Opens the imported merge file from the target session in the OS default viewer." />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Cancel / Close -->
            <Button Grid.Column="0"
                    HorizontalAlignment="Left"
                    Click="OnCancelClicked"
                    Margin="0"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel or close wizard"
                    AutomationProperties.HelpText="Closes the merge wizard without performing further actions. Disabled while a merge is running.">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource WizardButton}">
                        <Setter Property="Content" Value="Cancel" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.Done}">
                                <Setter Property="Content" Value="Close" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Step nav buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Back"
                        Command="{Binding BackCommand}"
                        AutomationProperties.Name="Back to target picker"
                        AutomationProperties.HelpText="Returns to the previous step so you can pick a different target session.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WizardButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.PreviewAndConfirm}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Next"
                        Command="{Binding NextCommand}"
                        IsDefault="True"
                        AutomationProperties.Name="Next: preview merge"
                        AutomationProperties.HelpText="Builds a preview of the markdown that will be appended to the selected target session.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.PickTarget}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Confirm merge"
                        Command="{Binding ConfirmMergeCommand}"
                        IsDefault="True"
                        AutomationProperties.Name="Confirm merge"
                        AutomationProperties.HelpText="Exports the source session via copilot --share and appends the markdown into the selected target session.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:MergeWizardStep.PreviewAndConfirm}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

