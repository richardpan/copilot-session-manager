<UserControl x:Class="CopilotSessionManager.Views.IssueLinksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CopilotSessionManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:IssueLinksViewModel}"
             d:DesignHeight="40" d:DesignWidth="320">
    <UserControl.Resources>
        <Style x:Key="IssueBadgeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddIssueButton" TargetType="Button">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
        <ItemsControl ItemsSource="{Binding Links}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:IssueLinkViewModel}">
                    <Button Style="{StaticResource IssueBadgeButton}"
                            Background="{Binding BadgeBrush}"
                            Command="{Binding OpenCommand}"
                            ToolTip="{Binding Tooltip}"
                            Margin="0,2,4,2"
                            AutomationProperties.Name="{Binding AutomationName}"
                            AutomationProperties.HelpText="Press Enter to open this issue in your browser. Right-click for more options.">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in browser"
                                          Command="{Binding OpenCommand}"
                                          AutomationProperties.Name="Open issue in browser" />
                                <Separator />
                                <MenuItem Header="Remove link"
                                          Command="{Binding RemoveCommand}"
                                          AutomationProperties.Name="Remove this issue link"
                                          AutomationProperties.HelpText="Detaches this issue from the session. The issue itself is unaffected." />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <!--
                                BadgeGlyph pairs the colour signal (open=green/closed=purple)
                                with a non-colour glyph (●/○) for colour-blind safety.
                            -->
                            <TextBlock Text="{Binding BadgeGlyph}"
                                       Foreground="#11111B"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Padding="8,2,2,2" />
                            <TextBlock Text="{Binding Display}"
                                       Foreground="#11111B"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Padding="0,2,8,2" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource AddIssueButton}"
                Content="+ Issue"
                Command="{Binding AddIssueCommand}"
                ToolTip="Link a GitHub issue to this session"
                AutomationProperties.Name="Add issue link"
                AutomationProperties.HelpText="Opens a dialog to link a new GitHub issue to this session." />
    </WrapPanel>
</UserControl>
